generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Todo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  isDone    Boolean  @default(false)
  priority  Int      @default(4)
  createdAt DateTime @default(now())
}
